# Line endings must not depend on who checked the file out: a spec written on
# Windows and read on CI is the same file, and a diff that is only CRLF is a
# review nobody can read.
* text=auto eol=lf

specs/**/spec.md        text eol=lf
specs/**/wireframe.html text eol=lf
specs/**/spec.link.yml  text eol=lf

*.sh text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
